# 云端 API 基础配置
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=8787
# 必填（至少 8 位），生产环境必须设置；本地演示可留空
API_TOKEN=
# 允许的来源，多个用逗号分隔；* 表示不限制
CORS_ORIGINS=*
LOG_LEVEL=info

# 华为云 RDS（PostgreSQL）；三项必须同时提供才启用持久化
RDS_HOST=
RDS_PORT=5432
RDS_DATABASE=
RDS_USER=
RDS_PASSWORD=
RDS_SSL=false

# 华为云 DCS Redis；提供 REDIS_HOST 才启用热点缓存
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 热点翻译缓存有效期（秒），默认 7 天
CACHE_TTL_SECONDS=604800

# 上游翻译：mock 为确定性离线实现，http 为可配置真实上游
UPSTREAM_KIND=mock
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
UPSTREAM_TIMEOUT_MS=15000