{
  "name": "bilingual-translator",
  "version": "0.3.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:compat": "vite build --config vite.chromium-compat.config.ts",
    "build:mv2": "tsx scripts/build-mv2.ts",
    "e2e": "pnpm build && pnpm build:compat && pnpm build:mv2 && playwright test",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "port:rules": "tsx scripts/port-rules.ts",
    "build:firefox": "vite build --config vite.firefox.config.ts",
    "build:safari": "vite build --config vite.safari.config.ts",
    "lint:firefox": "pnpm build:firefox && web-ext lint --source-dir dist-firefox",
    "build:userscript": "scripts/build-userscript.sh"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@huggingface/transformers": "4.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "preact": "^10.29.8",
    "webextension-polyfill": "^0.12.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^26.4.1",
    "@types/webextension-polyfill": "^0.12.6",
    "eslint": "^10.9.1",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "web-ext": "^10.6.0"
  },
  "packageManager": "pnpm@10.33.0"
}
